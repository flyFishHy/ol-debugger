{
  "name": "ol-debugger",
  "version": "0.1.0",
  "description": "An embeddable diagnostics panel for OpenLayers applications",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config vite.config.ts --mode library",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview --config vite.config.ts"
  },
  "peerDependencies": {
    "ol": "^10.0.0"
  },
  "dependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "ol": "^10.0.0",
    "sass": "^1.80.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
